# Candidate settings; physical PCB and peripherals still require verification.
CONFIG_BOARD_TYPE_ESP_VOCAT=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="profiles/teloa-bubble/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_USE_DEFAULT_MESSAGE_STYLE=y
CONFIG_WAKE_WORD_DISABLED=y
# CONFIG_USE_AUDIO_PROCESSOR is not set
# CONFIG_USE_DEVICE_AEC is not set
# CONFIG_USE_SERVER_AEC is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_TELOA_DIRECT=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Software verification only. No hardware Secure Boot, encryption or eFuse writes.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FLASH_NONE_ASSETS=y
