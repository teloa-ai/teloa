{
  "name": "@teloa/sdk",
  "version": "0.2.4",
  "description": "TypeScript and JavaScript client for the Teloa employee work API",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./contract": {
      "types": "./contract.d.mts",
      "default": "./contract.mjs"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "contract.mjs",
    "contract.d.mts",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/openapi.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
