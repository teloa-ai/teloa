  "components": {
    "securitySchemes": {
      "employeeApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Teloa integration key"
      }
    },
    "schemas": {
      "StartWork": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "employeeId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-8][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "permissionMode": {
            "type": "string",
            "enum": [
              "danger-full-access",
              "workspace-write",
              "read-only"
            ]
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              },
              "reasoningEffort": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              }
            },
            "required": [
              "provider",
              "model"
            ]
          }
        },
        "required": [
          "employeeId",
          "input"
        ]
      },
      "ContinueWork": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "permissionMode": {
            "type": "string",
            "enum": [
              "danger-full-access",
              "workspace-write",
              "read-only"
            ]
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              },
              "reasoningEffort": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
              }
            },
            "required": [
              "provider",
              "model"
            ]
