     {
      "name": "COMPOSIO_SEARCH_TOOLS",
      "description": {
       "zh-CN": "搜索可用的应用工具",
       "en": "Search available app tools"
      },
      "readOnly": true
     },
     {
      "name": "COMPOSIO_MULTI_EXECUTE_TOOL",
      "description": {
       "zh-CN": "执行已连接应用的工具",
       "en": "Execute tools on connected apps"
      },
      "readOnly": false
     }
    ],
    "upstreamUrl": "https://docs.composio.dev/mcp"
