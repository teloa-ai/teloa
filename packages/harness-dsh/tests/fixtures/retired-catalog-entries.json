   "connector": {
    "serverName": "composio",
    "title": {
     "zh-CN": "Composio MCP（1500+ 应用集成）",
     "en": "Composio MCP (1500+ App Integrations)"
    },
    "summary": {
     "zh-CN": "Composio 官方远程 MCP（Composio Connect），用少量通用工具发现并执行 1000 多个应用的操作。由 Teloa 以 OAuth（动态客户端注册 + PKCE）授权；各应用的账号连接和令牌由 Composio 平台保管，请求经 Composio 服务器转发。",
     "en": "Composio's official remote MCP (Composio Connect) that discovers and runs actions across 1000+ apps through a few general tools. Authorized by Teloa via OAuth (dynamic client registration + PKCE); app connections and tokens are held by the Composio platform, and requests are relayed through Composio's servers."
    },
    "auth": {
     "kind": "oauth",
     "supported": true,
     "scopes": []
    },
    "recipe": {
     "transport": "streamable-http",
     "url": "https://connect.composio.dev/mcp"
    },
