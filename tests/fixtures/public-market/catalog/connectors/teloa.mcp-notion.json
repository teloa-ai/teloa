{
  "format": "teloa.market-catalog-entry/v1",
  "id": "teloa.mcp-notion",
  "kind": "connector",
  "delivery": "managed",
  "version": "1.0.1",
  "taxonomy": {
    "functions": [
      "office-docs",
      "communication"
    ],
    "industries": [
      "general"
    ]
  },
  "upstream": null,
  "connector": {
    "serverName": "notion",
    "title": {
      "zh-CN": "Notion（本地 Bearer Token 模式）",
      "en": "Notion (Local Bearer Token Mode)"
    },
    "summary": {
      "zh-CN": "Notion 官方本地 MCP 服务，通过 Bearer Token 认证访问 Notion 工作区。注意：官方已不再主动维护此本地模式，推荐迁移到远程模式（待 OAuth 支持后）。",
      "en": "Notion's official local MCP service using Bearer Token authentication to access a Notion workspace. Note: official development has shifted to the remote mode; this local mode is no longer actively maintained."
    },
    "auth": {
      "kind": "secret",
      "vars": [
        {
          "target": "env",
          "envVarName": "NOTION_TOKEN",
          "label": {
            "zh-CN": "Notion Internal Integration Token（从 Notion 开发者控制台获取）",
            "en": "Notion Internal Integration Token (get from Notion developer console)"
          },
          "required": true
        }
      ]
    },
    "recipe": {
      "transport": "stdio",
      "package": "@notionhq/notion-mcp-server",
      "version": "2.5.2",
      "integrity": "sha512-5nPSwHMnugSGAhSJS5vVIlMao+iTJO9HoWGpCnT8lJNrPy3rZMqs1V/CPiN4MuxF+5EBgRE/f/Tirl6Wfi75Mg==",
      "bin": "bin/cli.mjs",
      "args": []
    },
    "tools": [
      {
        "name": "API-post-search",
        "description": {
          "zh-CN": "搜索 Notion 页面和数据源",
          "en": "Search Notion pages and data sources"
        },
        "readOnly": true
      },
      {
        "name": "API-retrieve-a-page",
        "description": {
          "zh-CN": "获取指定页面属性",
          "en": "Get page properties"
        },
        "readOnly": true
      },
      {
        "name": "API-retrieve-page-markdown",
        "description": {
          "zh-CN": "以 Markdown 读取页面内容",
          "en": "Read page content as Markdown"
        },
        "readOnly": true
      },
      {
        "name": "API-post-page",
        "description": {
          "zh-CN": "创建新页面",
          "en": "Create a page"
        },
        "readOnly": false
      },
      {
        "name": "API-patch-page",
        "description": {
          "zh-CN": "更新页面属性",
          "en": "Update page properties"
        },
        "readOnly": false
      },
      {
        "name": "API-query-data-source",
        "description": {
          "zh-CN": "查询数据源条目",
          "en": "Query data source entries"
        },
        "readOnly": true
      }
    ],
    "upstreamUrl": "https://github.com/makenotion/notion-mcp-server"
  },
  "modifications": [],
  "license": {
    "spdx": "MIT",
    "files": [
      "LICENSE"
    ]
  },
  "compatibility": {
    "status": "needs-configuration",
    "teloa": ">=0.2.0-alpha.6",
    "dsh": "0.1.7-rc.1",
    "conditions": [
      {
        "zh-CN": "需要 Notion Internal Integration Token",
        "en": "Requires Notion Internal Integration Token"
      },
      {
        "zh-CN": "官方已不再主动维护本地模式，建议远程模式（需 OAuth，下一版本支持）",
        "en": "Official local mode is no longer actively maintained; remote mode recommended (requires OAuth, supported in next version)"
      }
    ]
  },
  "requires": {
    "tools": [],
    "network": true,
    "runtimes": [
      "Node.js 18+"
    ]
  },
  "review": {
    "status": "approved",
    "reviewedAt": "2026-09-26",
    "reviewer": "Teloa"
  }
}
