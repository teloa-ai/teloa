{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "packages/client/**",
    "**/lib/**",
    "**/tsdown.config.ts",
    "packages/client/tsdown.preset.ts"
  ]
}
